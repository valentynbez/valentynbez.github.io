@article{diagnostic-accuracy-bladder-2023,
	title = {Diagnostic accuracy of bimanual palpation in bladder cancer patients undergoing cystectomy: {A} prospective study},
	volume = {41},
	copyright = {CC0 1.0 Universal Public Domain Dedication},
	issn = {1078-1439},
	shorttitle = {Diagnostic accuracy of bimanual palpation in bladder cancer patients undergoing cystectomy},
	url = {https://www.sciencedirect.com/science/article/pii/S1078143923001229},
	doi = {10.1016/j.urolonc.2023.04.001},
	abstract = {Objectives: To prospectively assess the concordance of examination under anesthesia (EUA)-based clinical T stage with pathological T stage and diagnostic accuracy of EUA in patients with bladder cancer undergoing cystectomy. Methods: Consecutive patients with bladder cancer undergoing cystectomy between June 2017 and October 2020 in a single academic center were included in a prospective study. Results: Bimanual palpation should still be used for clinical staging, given its specificity, NPV, and that it could correctly determine bladder cancer T stage in 80\% of cases. Conclusion: Awareness of imaging results did not have a major impact on EUA results.},
	number = {9},
	urldate = {2023-11-12},
	journal = {Urologic Oncology: Seminars and Original Investigations},
	author = {Czech, Anna K. and Gronostaj, Katarzyna and Fronczek, Jakub and Frydrych, Jakub and Bezshapkin, Valentyn and Przydacz, Mikolaj and Dudek, Przemyslaw and Curylo, Lukasz and Wiatr, Tomasz and Gasowski, Jerzy and Chlosta, Piotr L.},
	month = sep,
	year = {2023},
	keywords = {Bimanual palpation, Bladder cancer, Exam under anesthesia, Muscle-invasive bladder cancer, Staging},
	pages = {390.e27--390.e33},
}
