@article{predictors-vip2-2024,
	title = {Predictors of outcomes of patients ≥ 80 years old admitted to intensive care units in {Poland} – a post-hoc analysis of the {VIP2} prospective observational study},
	volume = {56},
	copyright = {All rights reserved},
	issn = {1642-5758},
	url = {https://www.ncbi.nlm.nih.gov/pmc/articles/PMC11022638/},
	doi = {10.5114/ait.2024.138192},
	abstract = {Background: Elderly patients pose a significant challenge to intensive care unit (ICU) clinicians. In this study we attempted to characterise the population of patients over 80 years old admitted to ICUs in Poland and identify associations between clinical features and short-term outcomes. Methods: The study is a post-hoc analysis of the Polish cohort of the VIP2 European prospective observational study enrolling patients > 80 years old admitted to ICUs over a 6-month period. Results: A total of 371 patients from 27 ICUs were enrolled. Frail patients had significantly higher ICU (58% vs. 44.45%, P = 0.03) and 30-day (65.61% vs. 54.14%, P = 0.01) mortality compared to non-frail counterparts. Conclusions: We found a positive correlation between CFS and ICU mortality, which might point to the value of assessing the score for every patient admitted to the ICU.},
	number = {1},
	urldate = {2024-09-02},
	journal = {Anaesthesiology Intensive Therapy},
	author = {Pasieka, Paweł Melchior and Kurek, Michał and Skupnik, Wojciech and Skwara, Evan and Bezshapkin, Valentyn and Fronczek, Jakub and Kluzik, Anna and Kudliński, Bartosz and Białka, Szymon and Studzińska, Dorota and Krzych, Łukasz J. and Czajka, Szymon and Stefaniak, Jan and Owczuk, Radosław and Sołek-Pastuszka, Joanna and Biernawska, Jowita and Zorska, Joanna and Krawczyk, Paweł and Cwyl, Katarzyna and Żukowski, Maciej and Kotfis, Katarzyna and Zegan-Barańska, Małgorzata and Wieczorek, Agnieszka and Mudyna, Wojciech and Piechota, Mariusz and Bernas, Szymon and Machała, Waldemar and Sadowski, Łukasz and Serwa, Marta and Czuczwar, Mirosław and Borys, Michał and Ziętkiewicz, Mirosław and Kozera, Natalia and Adamik, Barbara and Goździk, Waldemar and Nasiłowski, Paweł and Zatorski, Paweł and Trzebicki, Janusz and Gałkin, Piotr and Gawda, Ryszard and Kościuczuk, Urszula and Cyrankiewicz, Waldemar and Sierakowska, Katarzyna and Gola, Wojciech and Hymczak, Hubert and Flaatten, Hans and Szczeklik, Wojciech},
	month = mar,
	year = {2024},
	pages = {61--69},
}
